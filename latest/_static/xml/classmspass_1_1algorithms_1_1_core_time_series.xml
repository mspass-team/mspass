        <qualifiedname>mspass::algorithms::CoreTimeSeries::operator+=</qualifiedname>
        <param>
          <type>const <ref refid="classmspass_1_1algorithms_1_1_core_time_series_1a48794c92ef727de958653b7d395f6b5d" kindref="member">CoreTimeSeries</ref> &amp;</type>
          <declname>d</declname>
