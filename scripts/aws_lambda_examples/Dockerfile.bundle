FROM public.ecr.aws/lambda/python:3.13@sha256:c9b4d923d571121a1b00e2e5b43ea046d163b6e88a0d2fbcd0bc3be465593545 AS builder

COPY bundle-requirements.txt /tmp/bundle-requirements.txt
RUN python -m pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --no-compile \
        --only-binary=:all: \
        --require-hashes \
        --target /asset \
        --requirement /tmp/bundle-requirements.txt

COPY process.py aws_lambda_func_def.py /asset/
COPY bundle.py /tmp/bundle.py
RUN PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/asset \
    python /tmp/bundle.py build /asset /base.zip

FROM scratch
COPY --from=builder /base.zip /base.zip
