# General scientific RF preset: mtz_plane_wave_lowfreq.
#
# This is the public no-argument default for conventional scalar RF methods.
# It targets robust plane-wave/Kirchhoff imaging of P410s and P660s.  The
# Ricker output wavelet is intentionally shared by all branches so method
# comparisons do not silently compare different output bandwidths.

WaterLevel &Arr{
rf_preset mtz_plane_wave_lowfreq
water_level 0.1
operator_nfft 4096
shaping_wavelet_dt 0.05
deconvolution_data_window_start -10.0
deconvolution_data_window_end 120.0
wavelet_window_start -5.0
wavelet_window_end 20.0
target_sample_interval 0.05
shaping_wavelet_type ricker
shaping_wavelet_frequency 0.125
}
LeastSquare &Arr{
rf_preset mtz_plane_wave_lowfreq
damping_factor 1.0
operator_nfft 4096
shaping_wavelet_dt 0.05
deconvolution_data_window_start -10.0
deconvolution_data_window_end 120.0
wavelet_window_start -5.0
wavelet_window_end 20.0
target_sample_interval 0.05
shaping_wavelet_type ricker
shaping_wavelet_frequency 0.125
}
# Time-domain LS is retained for API completeness and mathematical tests, but
# is not a recommended long-window MTZ production operator.
TimeDomainLeastSquare &Arr{
rf_preset mtz_plane_wave_lowfreq
damping_factor 1.0e-6
operator_nfft 4096
shaping_wavelet_dt 0.05
deconvolution_data_window_start -10.0
deconvolution_data_window_end 120.0
wavelet_window_start -5.0
wavelet_window_end 20.0
target_sample_interval 0.05
shaping_wavelet_type ricker
shaping_wavelet_frequency 0.125
}
MultiTaperSpecDiv &Arr{
rf_preset mtz_plane_wave_lowfreq
damping_factor 0.1
shaping_wavelet_dt 0.05
shaping_wavelet_type ricker
shaping_wavelet_frequency 0.125
target_sample_interval 0.05
operator_nfft 4096
time_bandwidth_product 2.5
number_tapers 3
deconvolution_data_window_start -10.0
deconvolution_data_window_end 120.0
wavelet_window_start -5.0
wavelet_window_end 20.0
# The current multitaper engine requires noise no longer than the analysis
# window.  Use the full (-200,-10) noise span for LS/WL/CNR workflows.
noise_window_start -140.0
noise_window_end -10.0
}
MultiTaperXcor &Arr{
rf_preset mtz_plane_wave_lowfreq
damping_factor 0.03
shaping_wavelet_dt 0.05
shaping_wavelet_type ricker
shaping_wavelet_frequency 0.125
target_sample_interval 0.05
operator_nfft 4096
time_bandwidth_product 2.5
number_tapers 3
deconvolution_data_window_start -10.0
deconvolution_data_window_end 120.0
wavelet_window_start -5.0
wavelet_window_end 20.0
noise_window_start -140.0
noise_window_end -10.0
}
